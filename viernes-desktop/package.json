{
  "name": "viernes-desktop",
  "productName": "VIERNES",
  "version": "1.1.0",
  "description": "VIERNES - Asistente personal con automatización de PC",
  "main": "main.js",
  "author": "Daniel Naula",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^24.0.0"
  },
  "optionalDependencies": {
    "robotjs": "^0.6.0"
  },
  "build": {
    "appId": "com.viernes.asistente.desktop",
    "productName": "VIERNES",
    "win": {
      "target": "nsis",
      "icon": "../icon.svg"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@28.0.0": true
  }
}
